@model SatoraCaffeRestaurantTracking.Models.Reservation

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Rezervasyon Yap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', sans-serif;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .header-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 20px 20px 0 0;
            text-align: center;
        }

        .btn-custom {
            background-color: #764ba2;
            color: white;
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-custom:hover {
                background-color: #5a3780;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card card-custom">

                    <div class="header-gradient">
                        <h3 class="mb-0"><i class="far fa-calendar-alt me-2"></i>Masa Rezervasyonu</h3>
                        <small>Satora Cafe & Restaurant</small>
                    </div>

                    <div class="card-body p-4">

                        @if (ViewBag.Hata != null)
                        {
                            <div class="alert alert-warning text-center rounded-3">
                                <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Hata
                            </div>
                        }

                        <form method="post">

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Masa Seçiniz</label>
                                @Html.DropDownListFor(x => x.TableId, (SelectList)ViewBag.TableList, "--- Masa Seçiniz ---", new { @class = "form-select form-select-lg", required = "required" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Tarih ve Saat</label>
                                <input type="datetime-local" name="ReservationDate" class="form-control form-control-lg" required />
                                <small class="text-muted">Lütfen gelmek istediğiniz saati tam seçiniz.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Kişi Sayısı</label>
                                <input type="number" name="GuestCount" class="form-control form-control-lg" min="1" max="15" placeholder="Kaç kişisiniz?" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary">Özel İstekleriniz</label>
                                <textarea name="Description" class="form-control" rows="3" placeholder="Doğum günü, bebek sandalyesi vb..."></textarea>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-custom">
                                    Rezervasyonu Onayla <i class="fas fa-check-circle ms-2"></i>
                                </button>
                                <a href="/Customer/Index" class="btn btn-light text-muted">Vazgeç</a>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
