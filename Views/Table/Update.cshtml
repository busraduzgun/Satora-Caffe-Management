@model SatoraCaffeRestaurantTracking.Models.RestaurantTable
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Masayı Güncelle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 450px;
            background-color: #ffffff;
            overflow: hidden;
        }

        .card-header-custom {
            background-color: #FFE8A3;
            color: #5c5236;
            padding: 20px;
            text-align: center;
        }
        /* Sarı Tema */
        .btn-save {
            background-color: #FFE8A3;
            color: #5c5236;
            border-radius: 50px;
            padding: 12px;
            border: none;
            width: 100%;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-save:hover {
                background-color: #ffd66b;
            }

        .form-control {
            border-radius: 15px;
            padding: 12px;
        }
    </style>
</head>
<body>

    <div class="card card-custom">
        <div class="card-header-custom">
            <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Masa Düzenle</h3>
        </div>

        <div class="card-body p-4">
            <form method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="fw-bold">Servis Türü ID</label>
                    <input type="number" name="ServiceTypeId" value="@Model.ServiceTypeId" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Kapasite</label>
                    <input type="number" name="Capacity" value="@Model.Capacity" class="form-control" required />
                </div>
                <!--ADMIN OVERRIDE-->
                <!--manuel olarak masayı dolu veya boş yapabildiğimiz kısım -->
                <!--manuel kontrol ne işe yarar? -->
                <!-- bağlantı hatası, masanın kapatılmasının unutulması gibi sorunlarda -->
                <!--masayı kapatma, rezerve etme durumlarında-->
                <div class="mb-4">
                    <label class="fw-bold">Durum (Status)</label>
                    <select name="Status" class="form-control">
                        <!option value="0" @(Model.Status == 0 ? "selected" : "")>Boş (0)</!option>
                        <!option value="1" @(Model.Status == 1 ? "selected" : "")>Dolu (1)</!option>
                    </select>
                </div>

                <button type="submit" class="btn btn-save">
                    <i class="fas fa-check me-2"></i>Değişiklikleri Kaydet
                </button>

                <div class="text-center mt-3">
                    <a href="/Table/Index" class="text-muted text-decoration-none">Vazgeç</a>
                </div>

            </form>
        </div>
    </div>

</body>
</html>
