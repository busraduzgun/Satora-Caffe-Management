@model SatoraCaffeRestaurantTracking.Models.RestaurantTable
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Yeni Masa Ekle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        /* --- MASA EKLEME TEMASI (MINT & CLEAN) --- */
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 450px;
            background-color: #ffffff;
            overflow: hidden;
        }

        .card-header-custom {
            background-color: #90C8A2; /* Soft Sage Green */
            color: white;
            padding: 20px;
            text-align: center;
        }

        .form-label {
            font-weight: 700;
            color: #6B6E76;
        }

        .form-control {
            border-radius: 15px;
            padding: 12px;
            border: 2px solid #f0f0f0;
            background-color: #fcfcfc;
        }

            .form-control:focus {
                border-color: #90C8A2;
                box-shadow: 0 0 0 0.2rem rgba(144, 200, 162, 0.25);
            }

        .btn-save {
            background-color: #90C8A2;
            color: white;
            font-weight: 700;
            border-radius: 50px;
            padding: 12px;
            border: none;
            width: 100%;
            transition: 0.3s;
            margin-top: 10px;
        }

            .btn-save:hover {
                background-color: #7ab88e;
                transform: translateY(-2px);
            }

        .btn-cancel {
            color: #999;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-top: 20px;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div class="card card-custom">
        <div class="card-header-custom">
            <h3 class="mb-0"><i class="fas fa-chair me-2"></i>Yeni Masa Oluştur</h3>
        </div>

        <div class="card-body p-4">
            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Kapasite (Kaç Kişilik?)</label>
                    <input type="number" name="Capacity" class="form-control" placeholder="Örn: 4" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Servis Türü ID</label>
                    <input type="number" name="ServiceTypeId" class="form-control" placeholder="Örn: 1" required />
                    <small class="text-muted" style="font-size: 0.8rem;">
                        *Şimdilik geçerli bir ID giriniz (Örn: 1).
                    </small>
                </div>

                <button type="submit" class="btn btn-save">
                    <i class="fas fa-check me-2"></i>Masayı Kaydet
                </button>

                <a href="/Table/Index" class="btn-cancel">
                    <i class="fas fa-arrow-left me-1"></i> Vazgeç
                </a>

            </form>
        </div>
    </div>

</body>
</html>