@model SatoraCaffeRestaurantTracking.Models.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- 1. İSTENMEYEN ALANLARI GİZLE --- */
    /* En tepedeki Home/Privacy menüsünü kaldır */
    header {
        display: none !important;
    }
    /* En alttaki "Privacy" footer yazısını kaldır (İstersen bu satırı silebilirsin) */
    footer {
        display: none !important;
    }

    /* --- 2. RENK PALETİ --- */
    :root {
        --soft-sky-blue: #AEE3FF;
        --clear-day-blue: #75C8FF;
        --sun-pastel-yellow: #FFE8A3;
        --peach-glow: #FFBFA9;
        --mint-leaf-green: #B8E8C8;
        --soft-sage: #90C8A2;
        --cloud-gray: #E8E8EC;
        --soft-graphite: #6B6E76;
    }

    /* --- 3. GENEL SAYFA DÜZENİ --- */
    /* Navbar gidince üst boşluk kalmasın diye container ayarı */
    .owner-panel {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--soft-graphite);
        padding-top: 20px; /* Üstten biraz boşluk */
    }

    h2 {
        color: var(--clear-day-blue);
        font-weight: bold;
        text-shadow: 1px 1px 0px #fff;
    }

    /* --- 4. KART TASARIMLARI --- */
    .custom-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(117, 200, 255, 0.15);
        background-color: #fff;
        overflow: hidden;
        transition: transform 0.2s;
    }

        .custom-card:hover {
            transform: translateY(-3px);
        }

    .card-header {
        font-weight: 600;
        border-bottom: none;
        padding: 15px;
    }

    /* İstatistik Kart Renkleri */
    .stat-card.success {
        background-color: var(--mint-leaf-green);
        color: #4a6650;
    }

    .stat-card.info {
        background-color: var(--soft-sky-blue);
        color: #3e5c70;
    }

    .stat-card.primary {
        background-color: var(--clear-day-blue);
        color: #fff;
    }

    .stat-card.danger {
        background-color: var(--peach-glow);
        color: #7a4a3a;
    }

    .stat-card .card-title {
        font-size: 1.8rem;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .stat-card i {
        opacity: 0.6;
    }

    /* Tablo Header Renkleri */
    .header-dark {
        background-color: var(--soft-sage);
        color: #fff;
    }

    .header-warning {
        background-color: var(--sun-pastel-yellow);
        color: #5c5233;
    }

    .header-danger {
        background-color: var(--peach-glow);
        color: #7a4a3a;
    }

    .header-info {
        background-color: var(--soft-sky-blue);
        color: #3e5c70;
    }

    .header-secondary {
        background-color: var(--cloud-gray);
        color: var(--soft-graphite);
    }

    /* --- 5. TABLO TASARIMI --- */
    .table thead th {
        background-color: rgba(255,255,255,0.5);
        color: var(--soft-graphite);
        border-bottom: 2px solid var(--soft-sky-blue);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(184, 232, 200, 0.2);
    }

    /* Rozetler */
    .badge {
        padding: 8px 12px;
        border-radius: 8px;
        font-weight: 600;
    }

    .bg-pastel-blue {
        background-color: var(--clear-day-blue);
        color: #fff;
    }

    .bg-pastel-yellow {
        background-color: var(--sun-pastel-yellow);
        color: #5c5233;
    }

    .bg-pastel-green {
        background-color: var(--mint-leaf-green);
        color: #4a6650;
    }

    .bg-pastel-gray {
        background-color: var(--cloud-gray);
        color: var(--soft-graphite);
    }

    .bg-pastel-red {
        background-color: var(--peach-glow);
        color: #7a4a3a;
    }
</style>

<div class="container-fluid owner-panel">
    <h2 class="mb-4"><i class="fa fa-chart-line"></i> İşletme Özeti & Analiz</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="background-color: var(--peach-glow); border:none; color: #7a4a3a;">@ViewBag.Error</div>
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card custom-card stat-card success mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">@Model.Stats.GunlukCiro.ToString("C2")</h5>
                    <p class="card-text"><i class="fa fa-lira-sign"></i> Bugünün Cirosu</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card custom-card stat-card info mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">@Model.Stats.GunlukSiparis Adet</h5>
                    <p class="card-text"><i class="fa fa-receipt"></i> Bugünün Siparişi</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card custom-card stat-card primary mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">@Model.Stats.TahminiStokMaliyeti.ToString("C2")</h5>
                    <p class="card-text"><i class="fa fa-boxes"></i> Depo Değeri</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card custom-card stat-card danger mb-3">
                <div class="card-body text-center">
                    <h5 class="card-title">@Model.Stats.KritikStokSayisi Ürün</h5>
                    <p class="card-text"><i class="fa fa-exclamation-triangle"></i> Kritik Stok</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card custom-card">
                <div class="card-header header-dark">
                    <i class="fa fa-star me-2"></i> En Çok Satanlar
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Adet</th>
                                <th>Ciro</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BestSellers)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.ToplamSatisAdeti</td>
                                    <td>@item.ToplamCiro.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card custom-card">
                <div class="card-header header-warning">
                    <i class="fa fa-users me-2"></i> Personel Performansı
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Personel</th>
                                <th>Sipariş</th>
                                <th>Verimlilik</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in Model.StaffPerformance)
                            {
                                <tr>
                                    <td>
                                        @staff.PersonelAdi <br />
                                        <span class="badge bg-pastel-gray" style="font-size:0.7rem">@staff.Rol</span>
                                    </td>
                                    <td>@staff.SiparisSayisi</td>
                                    <td style="vertical-align:middle">
                                        <div class="progress" style="height: 10px; background-color: var(--cloud-gray);">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @staff.VerimlilikPuani%; background-color: var(--mint-leaf-green)!important;"
                                                 aria-valuenow="@staff.VerimlilikPuani" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <small class="text-muted">%@staff.VerimlilikPuani</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card custom-card">
                <div class="card-header header-danger">
                    <i class="fa fa-user-times me-2"></i> Pasif Kullanıcılar
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Tip</th>
                                <th>Ad Soyad</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.InactiveUsers)
                            {
                                <tr>
                                    <td>
                                        @if (user.KullaniciTipi == "Eski Personel")
                                        {
                                            <span class="badge bg-secondary">Personel</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-pastel-blue">Müşteri</span>
                                        }
                                    </td>
                                    <td>@user.AdSoyad</td>
                                    <td><small class="text-muted">@user.Durum</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card custom-card">
                <div class="card-header header-info">
                    <i class="fa fa-box-open me-2"></i> Kritik Stoklar
                </div>
                <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Stok</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stock in Model.StockReport)
                            {
                                <tr>
                                    <td>@stock.ProductName</td>
                                    <td>
                                        @if (stock.Stock <= 0)
                                        {
                                            <span class="badge bg-pastel-red">TÜKENDİ</span>
                                        }
                                        else if (stock.Stock < 20)
                                        {
                                            <span class="badge bg-pastel-yellow">KRİTİK</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-pastel-green">İYİ</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card custom-card">
                <div class="card-header header-secondary">
                    <i class="fa fa-history me-2"></i> Son İşlemler (Canlı Akış)
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Saat</th>
                                <th>Nokta</th>
                                <th>Personel</th>
                                <th>Ürün</th>
                                <th>Tutar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Transactions != null)
                            {
                                @foreach (var item in Model.Transactions)
                                {
                                    <tr>
                                        <td>@item.SiparisNo</td>
                                        <td>@item.Tarih.ToString("HH:mm")</td>
                                        <td>
                                            @if (item.SatisNoktasi.Contains("Masa"))
                                            {
                                                <span class="badge bg-pastel-blue">@item.SatisNoktasi</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-pastel-yellow">@item.SatisNoktasi</span>
                                            }
                                        </td>
                                        <td>@item.Personel</td>
                                        <td>@item.UrunAdi</td>
                                        <td>@item.ToplamTutar.ToString("C2")</td>
                                        <td>
                                            @if (item.Durum.Contains("Tamamlandı"))
                                            {
                                                <i class="fa fa-check text-success"></i>
                                            }
                                            else
                                            {

                                                <i class="fa fa-clock text-warning"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>