@using SatoraCaffeRestaurantTracking.Models
@model List<CartItem>

@{
    Layout = null;
    decimal grandTotal = Model.Sum(x => x.TotalPrice);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <title>Sepetim - Satora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            color: #555;
        }

        .cart-container {
            max-width: 800px;
            margin: 50px auto;
            background: white;
            border-radius: 25px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .btn-checkout {
            background-color: #75C8FF;
            color: white;
            width: 100%;
            border-radius: 50px;
            padding: 15px;
            font-weight: bold;
            font-size: 1.2rem;
            border: none;
            transition: 0.3s;
        }

            .btn-checkout:hover {
                background-color: #AEE3FF;
                transform: scale(1.02);
            }

        .cart-item-img {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            object-fit: cover;
            border: 2px solid #E8E8EC;
        }

        .btn-remove {
            color: #ff6b6b;
            background: #fff0f0;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: 0.3s;
        }

            .btn-remove:hover {
                background: #ff6b6b;
                color: white;
            }
    </style>
</head>
<body class="p-4">

    <div class="cart-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold" style="color: #75C8FF;"><i class="fas fa-shopping-cart me-2"></i>Sepetim</h2>
            <a href="/Customer/Menu" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">Menüye Dön</a>
        </div>

        @if (Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead style="color: #90C8A2;">
                        <tr>
                            <th>Ürün</th>
                            <th>Fiyat</th>
                            <th>Adet</th>
                            <th>Toplam</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="@item.Image" class="cart-item-img me-3">
                                        }
                                        else
                                        {
                                            <div class="cart-item-img me-3 d-flex align-items-center justify-content-center bg-light"><i class="fas fa-utensils text-muted"></i></div>
                                        }
                                        <span class="fw-bold">@item.ProductName</span>
                                    </div>
                                </td>
                                <td>@item.Price ₺</td>
                                <td><span class="badge bg-light text-dark border px-3 py-2 rounded-pill">x @item.Quantity</span></td>
                                <td class="fw-bold" style="color: #75C8FF;">@item.TotalPrice ₺</td>
                                <td>
                                    <a href="/Cart/RemoveFromCart/@item.ProductId" class="btn-remove" title="Azalt/Sil"><i class="fas fa-minus"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                <div class="text-end">
                    <h4 class="fw-bold mb-3">Toplam Tutar: <span style="color: #75C8FF;">@grandTotal ₺</span></h4>

                    <a href="/Cart/Checkout" class="btn btn-checkout shadow">
                        Siparişi Onayla <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-shopping-basket fa-4x mb-3" style="color: #E8E8EC;"></i>
                <h4 class="text-muted">Sepetin şu an boş.</h4>
                <p class="text-muted small">Lezzetli yemeklerimiz seni bekliyor!</p>
                <a href="/Customer/Menu" class="btn btn-primary rounded-pill mt-3 px-4" style="background-color: #90C8A2; border:none;">Alışverişe Başla</a>
            </div>
        }
    </div>

</body>
</html>