@model SatoraCaffeRestaurantTracking.Models.Customer

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Siparişi Tamamla - Satora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
        }

        .checkout-box {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            max-width: 600px;
            margin: 50px auto;
        }

        .btn-confirm {
            background-color: #AEE3FF;
            color: #555;
            font-weight: bold;
            border-radius: 50px;
            padding: 12px 40px;
            border: none;
            width: 100%;
            transition: 0.3s;
        }

            .btn-confirm:hover {
                background-color: #75C8FF;
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="checkout-box">
            <h2 class="text-center fw-bold mb-4" style="color: #75C8FF;">
                <i class="fas fa-map-marker-alt me-2"></i>Teslimat Adresi
            </h2>

            <form action="/Cart/CompleteOrder" method="post">

                <div class="mb-4">
                    <label class="form-label fw-bold text-muted">Ad Soyad</label>
                    <input type="text" class="form-control rounded-pill p-3 bg-light border-0" value="@Model.Name @Model.Surname" disabled>
                    <small class="text-muted ms-3">Sipariş bu isme teslim edilecektir.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-muted">Adres Bilgisi</label>
                    <textarea name="Address" class="form-control rounded-4 p-3 border-2" rows="4" style="border-color: #AEE3FF;" required>@Model.Address</textarea>
                    <small class="text-muted ms-3">Mevcut adresinizi değiştirebilirsiniz.</small>
                </div>

                <div class="alert alert-warning rounded-4 border-0 d-flex align-items-center">
                    <i class="fas fa-info-circle fa-2x me-3"></i>
                    <div>
                        <strong>Ödeme Yöntemi:</strong><br>
                        Şu an sadece <u>Kapıda Ödeme</u> kabul edilmektedir.
                    </div>
                </div>

                <button type="submit" class="btn btn-confirm mt-3">
                    Siparişi Tamamla <i class="fas fa-check-circle ms-2"></i>
                </button>

                <a href="/Cart/Index" class="btn btn-link text-muted w-100 mt-2 text-decoration-none">Sepete Geri Dön</a>

            </form>
        </div>
    </div>

</body>
</html>