@model SatoraCaffeRestaurantTracking.Models.Category

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Yeni Kategori Ekle - Satora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        /* --- SATORA PASTEL PALET --- */
        :root {
            --bg-color: #E8E8EC; /* Arka Plan */
            --card-bg: #ffffff; /* Kutu Rengi */
            --peach-glow: #FFBFA9; /* Başlık Rengi */
            --mint-green: #B8E8C8; /* Buton Rengi */
            --soft-graphite: #6B6E76; /* Yazı Rengi */
        }

        body {
            background-color: var(--bg-color);
            color: var(--soft-graphite);
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh; /* Sayfayı dikeyde ortalar */
        }

        .card-custom {
            border: none;
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 500px;
            overflow: hidden;
            background-color: var(--card-bg);
        }

        .card-header-custom {
            background-color: var(--peach-glow);
            color: white;
            padding: 25px;
            text-align: center;
        }

        .form-control {
            border-radius: 15px;
            padding: 12px;
            border: 2px solid #f0f0f0;
            background-color: #fcfcfc;
            color: var(--soft-graphite);
        }

            .form-control:focus {
                border-color: var(--peach-glow);
                box-shadow: 0 0 0 0.2rem rgba(255, 191, 169, 0.25);
            }

        .btn-save {
            background-color: var(--mint-green);
            color: #555;
            font-weight: 700;
            border-radius: 50px;
            padding: 12px;
            border: none;
            width: 100%;
            transition: 0.3s;
            margin-top: 10px;
        }

            .btn-save:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(184, 232, 200, 0.4);
            }

        .btn-cancel {
            color: #999;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-top: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .btn-cancel:hover {
                color: var(--soft-graphite);
            }

    </style>
</head>
<body>

    <div class="card card-custom">
        <div class="card-header-custom">
            <h3 class="mb-0"><i class="fas fa-magic me-2"></i>Yeni Kategori</h3>
            <small style="opacity: 0.9;">Menüye yeni bir lezzet grubu ekle</small>
        </div>

        <div class="card-body p-4">
            <form method="post">

                <div class="mb-4">
                    <label class="form-label fw-bold ms-1">Kategori Adı</label>
                    <input type="text" name="CategoryName" class="form-control" placeholder="Örn: Tatlılar, İçecekler..." required />
                </div>

                <div class="mb-4 form-check form-switch ms-1">
                    <input class="form-check-input" type="checkbox" name="Status" value="true" checked>
                    <label class="form-check-label">Kategori Aktif Görünsün</label>
                </div>

                <button type="submit" class="btn btn-save">
                    <i class="fas fa-check me-2"></i>Kaydet
                </button>

                <a href="/Category/Index" class="btn-cancel">
                    <i class="fas fa-arrow-left me-1"></i> Vazgeç ve Listeye Dön
                </a>

            </form>
        </div>
    </div>

</body>
</html>
