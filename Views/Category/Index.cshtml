@using SatoraCaffeRestaurantTracking.Models
@model List<SatoraCaffeRestaurantTracking.Models.Category>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Kategori Listesi - Satora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        /* --- SATORA PASTEL PALET --- */
        :root {
 
            --soft-sky-blue: #AEE3FF;
            --clear-day-blue: #75C8FF;
            --sun-pastel-yellow: #FFE8A3;
            --peach-glow: #FFBFA9; /* <- BU SAYFANIN TEMASI */
            --mint-leaf-green: #B8E8C8;
            --soft-sage: #90C8A2;
            --cloud-gray: #E8E8EC; /* Arka plan */
            --soft-graphite: #6B6E76; /* Yazı rengi */
            --white: #ffffff;
            /* Butonlar için yardımcı renkler */
            --btn-add-color: var(--mint-leaf-green); /* Ekleme (Yeşil) */
            --btn-edit-color: var(--clear-day-blue); /* Düzenleme (Mavi) */
            --btn-delete-color: #e94560; /* Silme (Kırmızı) */
        }

        body {
            background-color: var(--cloud-gray);
            color: var(--soft-graphite);
            font-family: 'Quicksand', sans-serif;
        }

        /* Ana Kart Tasarımı */
        .card-custom {
            background-color: var(--white);
            border: none;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        /* Kart Başlığı */
        .card-header-custom {
            background-color: var(--peach-glow); /* Tema rengi */
            color: var(--white);
            padding: 25px;
            border-bottom: none;
        }

        /* Tablo Tasarımı */
        .table-custom thead {
            background-color: #fff4f0; /* Çok açık şeftali tonu */
            color: var(--soft-graphite);
        }

        .table-custom th {
            font-weight: 700;
            border: none;
            padding: 20px 15px;
        }

        .table-custom td {
            vertical-align: middle;
            padding: 20px 15px;
            border-bottom: 1px solid #f0f0f0;
            font-weight: 500;
        }

        /* Tablo satırı hover efekti */
        .table-hover tbody tr:hover {
            background-color: #fff9f5; /* Hafif sıcak bir ton */
        }

        /* Butonlar (Yuvarlak, pastel) */
        .btn-custom {
            border-radius: 50px;
            padding: 10px 25px;
            font-weight: 700;
            border: none;
            transition: all 0.3s;
            color: var(--white);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

            .btn-custom:hover {
                opacity: 0.9;
                transform: translateY(-3px);
                box-shadow: 0 6px 12px rgba(0,0,0,0.15);
                color: var(--white);
            }

        .btn-add {
            background-color: var(--btn-add-color);
            color: var(--soft-graphite);
        }
        /* Ekle butonu yazısı koyu */
        .btn-edit {
            background-color: var(--btn-edit-color);
        }

        .btn-delete {
            background-color: var(--btn-delete-color);
        }

        /* Rozetler (Aktif/Pasif) */
        .badge-active {
            background-color: var(--mint-leaf-green);
            color: var(--soft-graphite);
            font-weight: 700;
        }

        .badge-passive {
            background-color: #ffcccc;
            color: var(--soft-graphite);
            font-weight: 700;
        }

        .empty-list-icon {
            font-size: 4rem;
            color: var(--peach-glow);
            opacity: 0.5;
        }

    </style>
</head>
<body class="p-5">

    <div class="container">
        <div class="card card-custom">

            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1"><i class="fas fa-folder-open me-2"></i>Kategoriler</h2>
                    <p class="mb-0" style="opacity: 0.9;">Menü başlıklarını buradan yönetebilirsiniz.</p>
                </div>
                <a href="/Category/Create" class="btn btn-custom btn-add">
                    <i class="fas fa-plus me-2"></i> Yeni Kategori
                </a>
            </div>

            <div class="card-body p-4">

                <table class="table table-hover table-custom">
                    <thead>
                        <tr>
                            <th style="width: 10%;">#ID</th>
                            <th style="width: 40%;">Kategori Adı</th>
                            <th style="width: 20%;">Durum</th>
                            <th style="width: 30%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@item.Id</td>

                                    <td style="font-size: 1.2rem; color: var(--soft-graphite);">
                                        @item.CategoryName
                                    </td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge badge-active rounded-pill px-3 py-2">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-passive rounded-pill px-3 py-2">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Category/Update/@item.Id" class="btn btn-sm btn-custom btn-edit me-2">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <a href="/Category/Delete/@item.Id" class="btn btn-sm btn-custom btn-delete">
                                            <i class="fas fa-trash-alt"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="empty-list-icon mb-3">
                                        <i class="fas fa-box-open"></i>
                                    </div>
                                    <h4 class="text-muted">Henüz hiç kategori eklenmemiş.</h4>
                                    <p class="text-muted">Yukarıdaki butonu kullanarak ilk kategoriyi ekleyebilirsin.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-4">
                    <a href="/Manager/Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left me-2"></i> Yönetim Paneline Dön
                    </a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>