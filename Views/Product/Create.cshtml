@model SatoraCaffeRestaurantTracking.Models.Product
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Yeni Ürün Ekle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-custom {
            width: 100%;
            max-width: 500px;
            border-radius: 20px;
            overflow: hidden;
            border: none;
            background: white;
        }

        .header {
            background-color: #75C8FF;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .btn-save {
            background-color: #B8E8C8;
            color: #444;
            border-radius: 50px;
            width: 100%;
            border: none;
            padding: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="card card-custom shadow">
        <div class="header"><h3>Yeni Ürün Ekle</h3></div>
        <div class="card-body p-4">
            <form method="post">

                <div class="mb-3">
                    <label>Ürün Adı</label>
                    <input type="text" name="ProductName" class="form-control" required />
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label>Fiyat (₺)</label>
                        <input type="text" name="UnitPrice" class="form-control" required placeholder="0.00" />
                    </div>
                    <div class="col">
                        <label>Stok</label>
                        <input type="number" name="Stock" class="form-control" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label>Kategori</label>
                    @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.v, "--- Seçiniz ---", new { @class = "form-select" })
                </div>

                <button class="btn btn-save">Kaydet</button>
                <a href="/Product/Index" class="d-block text-center mt-3 text-secondary text-decoration-none">Vazgeç</a>
            </form>
        </div>
    </div>
</body>
</html>