@model SatoraCaffeRestaurantTracking.Models.Product
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Ürün Güncelle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        /* Güncelleme Sayfası Teması: Sun Pastel Yellow */
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-custom {
            width: 100%;
            max-width: 500px;
            border-radius: 20px;
            overflow: hidden;
            border: none;
            background: white;
        }

        /* Başlık ve Buton Rengi */
        .header {
            background-color: #FFE8A3;
            color: #555;
            padding: 20px;
            text-align: center;
        }

        .btn-update {
            background-color: #FFE8A3;
            color: #444;
            border-radius: 50px;
            width: 100%;
            border: none;
            padding: 10px;
            font-weight: bold;
        }

            .btn-update:hover {
                background-color: #ffd66b;
            }
    </style>
</head>
<body>
    <div class="card card-custom shadow">
        <div class="header">
            <h3 class="mb-0">Ürün Bilgilerini Düzenle</h3>
        </div>
        <div class="card-body p-4">
            <form method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="mb-3">
                    <label>Ürün Adı</label>
                    <input type="text" name="ProductName" value="@Model.ProductName" class="form-control" required />
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label>Fiyat (₺)</label>
                        <input type="text" name="UnitPrice" value="@Model.UnitPrice.ToString("N2")" class="form-control" required />
                    </div>
                    <div class="col">
                        <label>Stok</label>
                        <input type="number" name="Stock" value="@Model.Stock" class="form-control" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label>Kategori</label>
                    @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.v, new { @class = "form-select" })
                </div>

                <button class="btn btn-update">Değişiklikleri Kaydet</button>
                <a href="/Product/Index" class="d-block text-center mt-3 text-secondary text-decoration-none">Vazgeç</a>
            </form>
        </div>
    </div>
</body>
</html>