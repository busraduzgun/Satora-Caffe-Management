@model SatoraCaffeRestaurantTracking.Models.Abouts
@{
    Layout = null; /* Üstteki Home/Privacy barını siler */
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hakkımızda Ayarları - Satora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --soft-sky-blue: #AEE3FF;
            --clear-day-blue: #75C8FF;
            --sun-pastel-yellow: #FFE8A3;
            --peach-glow: #FFBFA9;
            --mint-leaf-green: #B8E8C8;
            --cloud-gray: #E8E8EC;
            --soft-graphite: #6B6E76;
        }

        body {
            background-color: var(--cloud-gray);
            font-family: 'Quicksand', sans-serif;
            color: var(--soft-graphite);
        }

        .satora-card {
            background: white;
            border-radius: 25px;
            border: none;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        .btn-satora {
            background-color: var(--clear-day-blue);
            color: white;
            border-radius: 50px;
            border: none;
            font-weight: 700;
            transition: 0.3s;
        }

            .btn-satora:hover {
                background-color: var(--soft-sky-blue);
                transform: scale(1.05);
            }

        .btn-back {
            background-color: var(--peach-glow);
            color: white;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            padding: 8px 20px;
            display: inline-block;
        }
    </style>
</head>
<body class="p-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 style="color: var(--clear-day-blue); font-weight: 700;">🌸 Hakkımızda Ayarları</h2>
            <a href="/Manager/Index" class="btn-back">< Admin Paneline Dön</a>
        </div>

        <div class="mb-4 d-flex gap-2 justify-content-center">
            <a href="/Website/AboutSettings" class="btn btn-sm" style="background-color: var(--soft-sky-blue); color: #444; border-radius: 20px; font-weight: 700; padding: 5px 15px;">🌸 Hakkımızda</a>
            <a href="/Website/ContactSettings" class="btn btn-sm" style="background-color: var(--sun-pastel-yellow); color: #444; border-radius: 20px; font-weight: 700; padding: 5px 15px;">📍 İletişim</a>
            <a href="/Website/Messages" class="btn btn-sm" style="background-color: var(--mint-leaf-green); color: #444; border-radius: 20px; font-weight: 700; padding: 5px 15px;">💌 Mesajlar</a>
        </div>

        <div class="card satora-card p-4">
            <form asp-action="AboutSettings" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Başlık</label>
                    <input type="text" asp-for="Title" class="form-control" style="border-radius: 15px;">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="6" style="border-radius: 15px;"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Görsel URL</label>
                    <input type="text" asp-for="ImageUrl" class="form-control" style="border-radius: 15px;">
                </div>
                <button type="submit" class="btn btn-satora px-5 py-2">Değişiklikleri Kaydet</button>
            </form>
        </div>
    </div>
</body>
</html>