@using SatoraCaffeRestaurantTracking.Models
@model SatoraCaffeRestaurantTracking.Models.Staff

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Personel Ekle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #F0F2F5;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-custom {
            width: 100%;
            max-width: 500px;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            background: white;
        }

        .card-header {
            background-color: #75C8FF;
            color: white;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .btn-save {
            background-color: #75C8FF;
            border: none;
            padding: 12px;
            border-radius: 50px;
            width: 100%;
            font-weight: bold;
            color: white;
            margin-top: 15px;
            transition: 0.3s;
        }

            .btn-save:hover {
                background-color: #5db3f0;
                transform: translateY(-2px);
            }

        .form-label {
            font-weight: bold;
            color: #555;
            font-size: 0.9rem;
        }

        .section-divider {
            border-bottom: 2px dashed #eee;
            margin: 20px 0;
            position: relative;
        }

        .section-title {
            font-size: 0.8rem;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="card card-custom">
        <div class="card-header">
            <i class="fas fa-user-plus me-2"></i> Yeni Personel Kartı
        </div>
        <div class="card-body p-4">
            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Personel Adı</label>
                    <input type="text" name="Name" class="form-control" placeholder="Örn: Büşra" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Personel Soyadı</label>
                    <input type="text" name="Surname" class="form-control" placeholder="Örn: Yılmaz" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Görevi (Unvanı)</label>
                    <select name="RoleId" class="form-select" required>
                        <option value="">-- Bir Görev Seçin --</option>
                        @if (ViewBag.Roles != null)
                        {
                            foreach (var item in ViewBag.Roles)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="section-divider"></div>
                <div class="section-title">Giriş Bilgileri</div>

                <div class="mb-3">
                    <label class="form-label">Giriş Maili (Kullanıcı Adı)</label>
                    <input type="text" name="Email" class="form-control" placeholder="personel@satora.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Giriş Şifresi</label>
                    <input type="text" name="Password" class="form-control" placeholder="****" required />
                </div>

                <button type="submit" class="btn btn-save">KAYDET</button>

                <div class="text-center mt-3">
                    <a href="/Staff/Index" style="text-decoration:none; color:#999;">Vazgeç</a>
                </div>

            </form>
        </div>
    </div>

</body>
</html>