@using SatoraCaffeRestaurantTracking.Models
@model SatoraCaffeRestaurantTracking.Models.Staff

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Personel Güncelle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            background-color: #F0F2F5;
            font-family: 'Quicksand', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .card-custom {
            width: 100%;
            max-width: 500px;
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
            background: white;
        }

        .card-header {
            background-color: #ffca2c; /* Güncelleme olduğu için Sarı ton kullandım */
            color: white;
            padding: 20px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .btn-update {
            background-color: #ffca2c;
            border: none;
            padding: 12px;
            border-radius: 50px;
            width: 100%;
            font-weight: bold;
            color: white;
            margin-top: 15px;
            transition: 0.3s;
        }

            .btn-update:hover {
                background-color: #e6b422;
                transform: translateY(-2px);
            }

        .form-label {
            font-weight: bold;
            color: #555;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="card card-custom">
        <div class="card-header">
            <i class="fas fa-user-edit me-2"></i> Personel Düzenle
        </div>
        <div class="card-body p-4">
            <form method="post">
                <!-- userId ve status u gızledık -->
                <!--userId gizleyerek personelın baglı oldugu kullanıcı hesabının kopmamasını sagladık -->
                <!--status gizleyerek pesonelın aktıf,pasıf durumunu kaybetmeyeyı garantıledık-->
                <!--bu ıkı sutun kullanıcın varlıgını korumak ve dıger kullanıcılarla karısmasını engellyerek işlevsellik saglar -->
                <!--bu bılgılerı gızlıce sunucuya gondermıs olduk -->
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="UserId" value="@Model.UserId" />
                <input type="hidden" name="Status" value="@Model.Status.ToString()" />

                <div class="mb-3">
                    <label class="form-label">Personel Adı</label>
                    <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Personel Soyadı</label>
                    <input type="text" name="Surname" class="form-control" value="@Model.Surname" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Görevi (Unvanı)</label>
                    <select name="RoleId" class="form-select" required>
                        <option value="">-- Bir Görev Seçin --</option>
                        @if (ViewBag.Roles != null)
                        {
                            foreach (var item in ViewBag.Roles)
                            {
                                if (Model.RoleId.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-update">GÜNCELLE</button>

                <div class="text-center mt-3">
                    <a href="/Staff/Index" style="text-decoration:none; color:#999;">Vazgeç</a>
                </div>

            </form>
        </div>
    </div>

</body>
</html>