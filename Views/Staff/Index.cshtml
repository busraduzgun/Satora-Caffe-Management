@using SatoraCaffeRestaurantTracking.Models
@model List<Staff>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Personel Listesi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            padding: 40px;
        }

        .staff-card {
            background-color: white;
            border-radius: 20px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: 0.3s;
            position: relative;
            overflow: hidden;
        }

            .staff-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            }

        /* Üstteki renkli şerit */
        .card-top-line {
            height: 5px;
            width: 100%;
            background: linear-gradient(90deg, #75C8FF, #AEE3FF);
            position: absolute;
            top: 0;
            left: 0;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            background-color: #f0f0f0;
            border-radius: 50%;
            margin: 15px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #75C8FF;
            font-size: 2rem;
        }

        .staff-name {
            font-weight: bold;
            font-size: 1.2rem;
            color: #444;
            margin-bottom: 10px;
        }

        .staff-role {
            color: #888;
            font-size: 0.85rem;
            margin-bottom: 15px;
        }

        .badge-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .status-active {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .status-passive {
            background-color: #f8d7da;
            color: #842029;
        }

        .btn-add {
            background-color: #75C8FF;
            color: white;
            border-radius: 50px;
            font-weight: bold;
            border: none;
        }

        /* İşlem Butonları */
        .action-btns {
            margin-top: 15px;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }

        .btn-icon {
            color: #999;
            margin: 0 5px;
            transition: 0.3s;
        }

            .btn-icon:hover {
                color: #75C8FF;
            }

        .btn-icon-del:hover {
            color: #ff6b6b;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #6B6E76;"><i class="fas fa-users me-2"></i>Personel Kadrosu</h2>
            <a href="/Staff/Create" class="btn btn-add px-4 py-2 shadow-sm"><i class="fas fa-plus me-2"></i>Yeni Personel</a>
        </div>

        <div class="row">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <div class="col-md-3 mb-4">
                        <div class="staff-card">
                            <div class="card-top-line"></div>

                            <div class="avatar-circle">
                                <i class="fas fa-user"></i>
                            </div>

                            <div class="staff-name">@item.Name @item.Surname</div>

                            <div class="staff-role">
                                @if (item.Role != null)
                                {
                                    @item.Role.RoleNmae
                                }
                                else
                                {
                                    <span class="text-danger" style="font-size:0.8rem;">Rol Atanmamış</span>
                                }
                            </div>

                            @if (item.Status == true)
                            {
                                <span class="badge-status status-active">Aktif</span>
                            }
                            else
                            {
                                <span class="badge-status status-passive">Pasif</span>
                            }

                            <div class="action-btns">
                                <a href="/Staff/Update/@item.Id" class="btn-icon" title="Düzenle"><i class="fas fa-pen"></i></a>

                                <a href="/Staff/Delete/@item.Id" class="btn-icon btn-icon-del" onclick="return confirm('Silmek istediğine emin misin?');" title="Sil"><i class="fas fa-trash"></i></a>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted mt-5">
                    <h4>Kayıtlı personel bulunamadı.</h4>
                </div>
            }
        </div>

        <a href="/Manager/Index" class="btn btn-outline-secondary rounded-pill mt-4">
            <i class="fas fa-arrow-left me-2"></i> Yönetim Paneline Dön
        </a>
    </div>

</body>
</html>