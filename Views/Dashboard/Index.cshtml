@model SatoraCaffeRestaurantTracking.Models.DashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Satora - Günlük Operasyon Raporu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <style>
        body {
            background-color: #E8E8EC;
            font-family: 'Quicksand', sans-serif;
            color: #6B6E76;
            padding: 30px;
        }

        /* Renkler */
        .text-blue {
            color: #75C8FF;
        }

        .text-peach {
            color: #FFBFA9;
        }

        .bg-sky {
            background-color: #75C8FF;
            color: white;
        }

        .bg-peach {
            background-color: #FFBFA9;
            color: white;
        }

        .bg-yellow {
            background-color: #FFE8A3;
            color: #6B6E76;
        }

        .bg-green {
            background-color: #B8E8C8;
            color: white;
        }

        /* Kart Yapıları */
        .report-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            height: 100%;
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: 0.3s;
        }

            .report-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            }

        .card-header-custom {
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .badge-critical {
            background: #FFF0EB;
            color: #FFBFA9;
            padding: 5px 10px;
            border-radius: 8px;
            font-weight: bold;
        }
    </style>

    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', {'packages':['corechart', 'bar']});
        google.charts.setOnLoadCallback(drawCharts);

        function drawCharts() {
            // 1. SAATLİK YOĞUNLUK
            var dataDensity = new google.visualization.DataTable();
            dataDensity.addColumn('string', 'Saat');
            dataDensity.addColumn('number', 'Sipariş');

            dataDensity.addRows([
                @foreach (var item in Model.SaatlikYogunluk)
                {
                        // DÜZELTME 1: @Html.Raw(...) kullanıldı
                        <text>['@Html.Raw(item.Key)', @item.Value],</text>
                }
            ]);

            var optionsDensity = {
                colors: ['#75C8FF'], legend: { position: 'none' },
                fontName: 'Quicksand', vAxis: { minValue: 0, format: '0' },
                chartArea: { width: '85%', height: '70%' }
            };
            var chartDensity = new google.visualization.ColumnChart(document.getElementById('density_chart'));
            chartDensity.draw(dataDensity, optionsDensity);

            // 2. EN ÇOK SATANLAR
            var dataTop = google.visualization.arrayToDataTable([
              ['Ürün', 'Adet'],
              @foreach (var item in Model.EnCokSatilanlar)
              {
                       // DÜZELTME 2: @Html.Raw(...) kullanıldı
                       <text>['@Html.Raw(item.Key)', @item.Value],</text>
              }
            ]);

            var optionsTop = {
                pieHole: 0.5, colors: ['#75C8FF', '#FFBFA9', '#FFE8A3', '#B8E8C8', '#E14FB4'],
                fontName: 'Quicksand', legend: { position: 'right' },
                chartArea: { width: '90%', height: '80%' }
            };
            var chartTop = new google.visualization.PieChart(document.getElementById('top_products_chart'));
            chartTop.draw(dataTop, optionsTop);
        }
    </script>
</head>
<body>
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 style="font-weight:bold; color:#75C8FF;"><i class="fas fa-clipboard-list me-2"></i>Satora Raporlar</h3>
                <small class="text-muted">Günlük Operasyon ve Analiz Ekranı</small>
            </div>
            <div class="bg-yellow px-3 py-2 rounded-pill fw-bold">
                @DateTime.Now.ToString("dd MMMM yyyy")
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="report-card d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">TOPLAM CİRO</div>
                        <h2 class="mb-0 text-blue fw-bold">@Model.GunlukCiro ₺</h2>
                    </div>
                    <i class="fas fa-wallet fa-2x text-black-50 opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="report-card d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">MÜŞTERİ SAYISI</div>
                        <h2 class="mb-0 text-secondary fw-bold">@Model.MusteriSayisi</h2>
                    </div>
                    <i class="fas fa-users fa-2x text-black-50 opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="report-card d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">AÇIK MASA</div>
                        <h2 class="mb-0 text-warning fw-bold">@Model.AcikSiparis</h2>
                    </div>
                    <i class="fas fa-utensils fa-2x text-black-50 opacity-25"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="report-card d-flex align-items-center justify-content-between" style="border: 1px solid #FFBFA9;">
                    <div>
                        <div class="text-muted small">PROBLEMLER</div>
                        <h5 class="mb-0 text-peach fw-bold">@Model.GecikenSiparis Gecikme</h5>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-2x text-peach"></i>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-lg-8">

                <div class="report-card mb-4">
                    <div class="card-header-custom text-peach">
                        <span><i class="fas fa-boxes me-2"></i> Kritik Stoklar (< 20)</span>
                        <a href="/Product/Index" class="btn btn-sm btn-outline-secondary rounded-pill">Yönet</a>
                    </div>
                    <table class="table table-hover align-middle">
                        <thead class="text-muted small">
                            <tr><th>ÜRÜN</th><th>FİYAT</th><th>STOK</th><th>DURUM</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.KritikStoklar)
                            {
                                <tr>
                                    <td class="fw-bold">@item.ProductName</td>
                                    <td>@item.UnitPrice ₺</td>
                                    <td class="text-peach fw-bold">@item.Stock</td>
                                    <td><span class="badge-critical">AZALDI</span></td>
                                </tr>
                            }
                            @if (Model.KritikStoklar.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-success py-3">Stok sorunu yok! 🌸</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="report-card">
                    <div class="card-header-custom text-blue">
                        <span><i class="fas fa-clock me-2"></i> Saatlik Yoğunluk</span>
                    </div>
                    <div id="density_chart" style="width: 100%; height: 250px;"></div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="report-card mb-4">
                    <div class="card-header-custom" style="color:#90C8A2;">
                        <span><i class="fas fa-crown me-2"></i> Günün Yıldızları</span>
                    </div>
                    <div id="top_products_chart" style="width: 100%; height: 200px;"></div>
                </div>

                <div class="report-card text-center d-flex flex-column justify-content-center">
                    <i class="fas fa-check-circle fa-3x text-success mb-3 opacity-50"></i>
                    <h5>Sistem Durumu</h5>
                    <p class="text-muted small">Tüm servisler aktif çalışıyor.</p>
                </div>

            </div>
        </div>

    </div>
</body>
</html>