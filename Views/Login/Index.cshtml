@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Giriş Yap - Satora Cafe</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* Paletten Renkler */
        :root {
            --bg-gradient-start: #AEE3FF; /* Soft Sky Blue */
            --bg-gradient-end: #E8E8EC; /* Cloud Gray */
            --card-bg: #ffffff;
            --text-color: #6B6E76; /* Soft Graphite */
            --primary-btn: #75C8FF; /* Clear Day Blue */
            --primary-btn-hover: #FFBFA9; /* Peach Glow - Hover için */
            --input-border: #B8E8C8; /* Mint Leaf Green */
        }

        body {
            /* Arka plana yumuşak bir gökyüzü geçişi verelim */
            background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Fredoka', sans-serif; /* Yuvarlak, sevimli font */
            color: var(--text-color);
        }

        .login-kutu {
            width: 400px;
            padding: 45px;
            background: var(--card-bg);
            border-radius: 20px; /* Daha yuvarlak köşeler */
            /* Çok hafif, renkli bir gölge */
            box-shadow: 0 10px 25px rgba(117, 200, 255, 0.15);
            border: 2px solid #ffffff; /* Beyaz çerçeve ile netlik */
        }

        h3.card-title {
            color: var(--primary-btn);
            font-weight: 500;
            margin-bottom: 30px;
            letter-spacing: 1px;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-control {
            border-radius: 12px;
            border: 2px solid var(--input-border); /* Nane yeşili çerçeve */
            padding: 12px;
            background-color: #F9FDFB; /* Çok açık nane tonu zemin */
        }

            .form-control:focus {
                /* Tıklanınca mavi yansıma */
                box-shadow: 0 0 0 4px rgba(117, 200, 255, 0.2);
                border-color: var(--primary-btn);
            }

        .btn-pastel {
            background-color: var(--primary-btn);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-size: 18px;
            font-weight: 500;
            color: white;
            transition: all 0.3s ease;
        }

            .btn-pastel:hover {
                /* Üzerine gelince şeftali tonuna dönsün */
                background-color: var(--primary-btn-hover);
                color: white;
                transform: translateY(-2px); /* Hafif yukarı kalkma efekti */
            }

        .alert-danger {
            border-radius: 12px;
            background-color: #FFEBEE;
            border-color: #FFCDD2;
            color: #D32F2F;
        }

        /* Yeni eklenen link için stil */
        .register-link {
            color: var(--primary-btn);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

            .register-link:hover {
                color: var(--primary-btn-hover);
            }
    </style>
</head>
<body>

    <div class="login-kutu text-center">
        <h3 class="card-title">✨ Satora Cafe Giriş</h3>

        <form action="/Login/GirisYap" method="post" class="text-start">

            <div class="mb-4">
                <label class="form-label">E-Posta Adresi</label>
                <input type="email" name="email" class="form-control" placeholder="ornek@satora.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                <input type="password" name="sifre" class="form-control" placeholder="******" required />
            </div>

            @if (ViewBag.Hata != null)
            {
                <div class="alert alert-danger text-center mb-4">
                    @ViewBag.Hata
                </div>
            }

            <button type="submit" class="btn btn-pastel w-100">GİRİŞ YAP</button>
        </form>

        <div class="text-center mt-4">
            <span style="font-size: 0.9rem;">Hesabın yok mu?</span>
            <a href="/Register/Index" class="register-link">Hemen Kayıt Ol</a>
        </div>
    </div>

</body>
</html>