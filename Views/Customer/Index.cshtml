@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Satora Cafe & Restaurant</title>

    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        :root {
            --pastel-blue: #AEE3FF;
            --pastel-pink: #FFBFA9;
            --pastel-yellow: #FFE8A3;
            --pastel-green: #B8E8C8;
            --dark-text: #555;
        }

        body {
            font-family: 'Quicksand', sans-serif;
            color: var(--dark-text);
            background-color: #fcfcfc;
            overflow-x: hidden;
        }

        /* --- HERO BÖLÜMÜ (Giriş) --- */
        .hero-section {
            background: linear-gradient(135deg, var(--pastel-blue) 0%, #fff 100%);
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
        }

        .hero-title {
            font-family: 'Dancing Script', cursive;
            font-size: 5rem;
            color: #75C8FF;
            text-shadow: 2px 2px 0px #fff;
        }

        .hero-subtitle {
            font-size: 1.5rem;
            color: #888;
            margin-bottom: 30px;
        }

        .btn-menu {
            background-color: var(--pastel-pink);
            color: white;
            padding: 15px 40px;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 10px 20px rgba(255, 191, 169, 0.4);
            border: none;
        }

            .btn-menu:hover {
                transform: translateY(-5px);
                background-color: #ffad91;
                color: white;
            }

        /* --- HAKKIMIZDA --- */
        .about-section {
            padding: 80px 0;
        }

        .about-img {
            border-radius: 30px;
            box-shadow: 20px 20px 0px var(--pastel-yellow);
            max-width: 100%;
        }

        .section-title {
            font-weight: 700;
            color: var(--pastel-green);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 1rem;
        }

        /* --- İLETİŞİM FORMU --- */
        .contact-box {
            background-color: white;
            border-radius: 30px;
            padding: 40px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.05);
            border-top: 10px solid var(--pastel-blue);
        }

        .form-control {
            background-color: #f9f9f9;
            border: none;
            padding: 15px;
            border-radius: 15px;
            margin-bottom: 15px;
        }

            .form-control:focus {
                box-shadow: none;
                background-color: #fff;
                border: 2px solid var(--pastel-blue);
            }

        /* --- FOOTER --- */
        footer {
            background-color: #333;
            color: white;
            padding: 50px 0;
            margin-top: 80px;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
        }

        /* GİRİŞ YAP BUTONU (Sağ Üst) */
        .login-btn-top {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: rgba(255,255,255,0.8);
            padding: 8px 20px;
            border-radius: 30px;
            text-decoration: none;
            color: #555;
            font-weight: bold;
            font-size: 0.9rem;
            transition: 0.3s;
        }

            .login-btn-top:hover {
                background-color: white;
                color: var(--pastel-blue);
            }

        .btn-outline-purple:hover {
            background-color: #9D76C1;
            color: white !important;
        }
    </style>
</head>
<body>

    @if (Context.Request.Query["siparisDurumu"] == "basarili")
    {
        <div class="alert alert-success alert-dismissible fade show text-center m-0 rounded-0 p-4 shadow-sm" role="alert" style="background-color: #B8E8C8; color: #2C5F2D; border:none; z-index: 9999; position: relative;">
            <div class="d-flex justify-content-center align-items-center">
                <i class="fas fa-check-circle fa-2x me-3"></i>
                <div class="text-start">
                    <h5 class="fw-bold mb-0">Siparişiniz Alındı! 🚀</h5>
                    <small>Sipariş Numaranız: <strong>#@Context.Request.Query["siparisNo"]</strong>. Hazırlanmaya başlıyor...</small>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="hero-section">
        <a href="/Login/Index" class="login-btn-top"><i class="fas fa-lock me-2"></i>Personel Girişi</a>

        <div class="container">
            <h1 class="hero-title">Satora Cafe</h1>
            <p class="hero-subtitle">Lezzetin ve huzurun buluşma noktası.</p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">

                <a href="/Customer/Menu" class="btn-menu">
                    <i class="fas fa-utensils me-2"></i> MENÜYÜ İNCELE
                </a>

                <a href="/Customer/MyOrders" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center" style="border: 2px solid #ddd; background: rgba(255,255,255,0.7); font-weight:bold; color: #555;">
                    <i class="fas fa-history me-2"></i>Siparişlerim
                </a>

                <a href="/Customer/MyMessages" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center" style="border: 2px solid #ddd; background: rgba(255,255,255,0.7); font-weight:bold; color: #555;">
                    <i class="fas fa-envelope me-2"></i>Mesajlarım
                </a>

                <a href="/Customer/Profile" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center" style="border: 2px solid #ddd; background: rgba(255,255,255,0.7); font-weight:bold; color: #555;">
                    <i class="fas fa-user-circle me-2"></i>Profilim
                </a>

            </div>

            <div class="mt-5">
                <i class="fas fa-chevron-down fa-2x text-muted animate__animated animate__bounce infinite"></i>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: -60px; position: relative; z-index: 2;">
        <div class="row justify-content-center">

            <div class="col-md-5 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius: 20px; transition: transform 0.3s;">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-block p-3 rounded-circle" style="background-color: #E0B0FF; color: white;">
                                <i class="fas fa-calendar-alt fa-2x"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold text-dark">Masa Rezervasyonu</h4>
                        <p class="text-muted small">
                            Özel günleriniz veya akşam yemeğiniz için şimdiden yerinizi ayırtın, sıra beklemeyin.
                        </p>
                        <a href="/Reservation/Create" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                            Rezervasyon Yap <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-5 mb-4">
                <div class="card h-100 shadow border-0" style="border-radius: 20px; transition: transform 0.3s; background-color: #fdfdfd;">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <span class="d-inline-block p-3 rounded-circle" style="background-color: #9D76C1; color: white;">
                                <i class="fas fa-history fa-2x"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold text-dark">Rezervasyonlarım</h4>
                        <p class="text-muted small">
                            Bekleyen, onaylanan veya geçmiş rezervasyonlarınızın durumunu buradan kontrol edin.
                        </p>
                        <a href="/Reservation/MyReservations" class="btn btn-outline-purple rounded-pill px-4 fw-bold" style="border-color: #9D76C1; color: #9D76C1;">
                            Listeyi Gör <i class="fas fa-chevron-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="container about-section">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4">
                @if (ViewBag.About != null)
                {
                    <img src="@ViewBag.About.ImageUrl" class="about-img" alt="Hakkımızda" onerror="this.src='https://images.unsplash.com/photo-1554118811-1e0d58224f24?ixlib=rb-1.2.1&auto=format&fit=crop&w=1347&q=80'">
                }
                else
                {
                    <img src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?ixlib=rb-1.2.1&auto=format&fit=crop&w=1347&q=80" class="about-img" alt="Varsayılan Resim">
                }
            </div>
            <div class="col-md-6 ps-md-5">
                <span class="section-title">BİZ KİMİZ?</span>
                <h2 class="fw-bold mb-4" style="color: #444;">Hikayemiz & Tutkumuz</h2>

                @if (ViewBag.About != null)
                {
                    <h4 class="fw-bold text-muted">@ViewBag.About.Title</h4>
                    <p class="lead" style="font-size: 1.1rem; line-height: 1.8;">
                        @ViewBag.About.Description
                    </p>
                }
                else
                {
                    <p class="text-muted">Henüz hakkımızda yazısı eklenmemiş. Yönetim panelinden ekleyebilirsiniz.</p>
                }

                <div class="mt-4 d-flex gap-3">
                    <div class="text-center">
                        <i class="fas fa-coffee fa-2x mb-2" style="color: var(--pastel-pink);"></i>
                        <p class="small fw-bold">Taze Kahve</p>
                    </div>
                    <div class="text-center">
                        <i class="fas fa-wifi fa-2x mb-2" style="color: var(--pastel-blue);"></i>
                        <p class="small fw-bold">Hızlı WiFi</p>
                    </div>
                    <div class="text-center">
                        <i class="fas fa-music fa-2x mb-2" style="color: var(--pastel-yellow);"></i>
                        <p class="small fw-bold">Rahat Ortam</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row">
            <div class="col-md-5 mb-4">
                <span class="section-title">BİZE ULAŞIN</span>
                <h2 class="fw-bold mb-4">İletişim Bilgileri</h2>

                @if (ViewBag.Contact != null)
                {
                    <div class="d-flex align-items-start mb-4">
                        <i class="fas fa-map-marker-alt fa-2x me-3" style="color: var(--pastel-blue);"></i>
                        <div>
                            <h5 class="fw-bold">Adres</h5>
                            <p class="text-muted">@ViewBag.Contact.Address</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <i class="fas fa-phone-alt fa-2x me-3" style="color: var(--pastel-pink);"></i>
                        <div>
                            <h5 class="fw-bold">Telefon</h5>
                            <p class="text-muted">@ViewBag.Contact.Telephone</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <i class="fas fa-envelope fa-2x me-3" style="color: var(--pastel-green);"></i>
                        <div>
                            <h5 class="fw-bold">E-Posta</h5>
                            <p class="text-muted">@ViewBag.Contact.Email</p>
                        </div>
                    </div>

                    <div class="alert alert-warning rounded-4 border-0">
                        <i class="fas fa-clock me-2"></i> <strong>Çalışma Saatleri:</strong><br>
                        @ViewBag.Contact.OpeningHours
                    </div>
                }
            </div>

            <div class="col-md-7">
                <div class="contact-box">
                    <h3 class="fw-bold mb-4">💌 Bize Mesaj Gönderin</h3>

                    @if (TempData["Mesaj"] != null)
                    {
                        <div class="alert alert-success rounded-3">@TempData["Mesaj"]</div>
                    }

                    <form action="/Customer/SendMessage" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <input type="text" name="SenderName" class="form-control" placeholder="Adınız Soyadınız" required>
                            </div>
                            <div class="col-md-6">
                                <input type="email" name="Email" class="form-control" placeholder="E-Posta Adresiniz" required>
                            </div>
                        </div>
                        <input type="text" name="Subject" class="form-control" placeholder="Konu (Örn: Rezervasyon, Teşekkür)" required>
                        <textarea name="Content" class="form-control" rows="4" placeholder="Mesajınız..." required></textarea>

                        <button type="submit" class="btn btn-menu w-100" style="background-color: var(--pastel-blue);">GÖNDER</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="container text-center">
            <h2 style="font-family: 'Dancing Script', cursive; color: var(--pastel-yellow);">Satora Cafe</h2>
            <p class="text-muted mb-4">Lezzetli anlar, unutulmaz anılar.</p>
            <div class="d-flex justify-content-center gap-3 mb-4">
                <a href="#" class="text-white"><i class="fab fa-instagram fa-lg"></i></a>
                <a href="#" class="text-white"><i class="fab fa-twitter fa-lg"></i></a>
                <a href="#" class="text-white"><i class="fab fa-facebook fa-lg"></i></a>
            </div>
            <small class="text-secondary">&copy; 2025 Satora Cafe & Restaurant Tracking System. Tüm hakları saklıdır.</small>
        </div>
    </footer>

</body>
</html>