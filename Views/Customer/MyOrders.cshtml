@using SatoraCaffeRestaurantTracking.Models
@model List<Order>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Sipariş Geçmişim - Satora</title>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #fcfcfc;
        }

       
        .header-bg {
            background-color: #AEE3FF;
            padding: 40px 0;
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        .btn-back {
            background-color: #FFBFA9; /* Şeftali tonu */
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 50px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
        }

            .btn-back:hover {
                background-color: #ffaa8f;
                color: white;
            }

        /* Sipariş Kartı Tasarımı */
        .order-card {
            background: white;
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-left: 10px solid #FFD56F; /* Sarı şerit */
            transition: transform 0.2s;
        }

            .order-card:hover {
                transform: translateY(-3px);
            }

        .price-tag {
            color: #2C5F2D;
            font-weight: bold;
            font-size: 1.5rem;
        }

        .status-badge {
            background-color: #FFD56F;
            color: #555;
            padding: 5px 15px;
            border-radius: 10px;
            font-weight: bold;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="header-bg">
        <h2 class="fw-bold mb-3"><i class="fas fa-receipt me-2"></i>Sipariş Geçmişim</h2>
        <a href="/Customer/Index" class="btn-back">
            <i class="fas fa-arrow-left me-2"></i>Ana Sayfaya Dön
        </a>
    </div>

    <div class="container">

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-light text-center p-5 rounded-4 shadow-sm">
                <i class="fas fa-utensils fa-3x mb-3 text-muted"></i>
                <h4 class="text-muted">Henüz siparişiniz bulunmuyor.</h4>
                <p>İlk siparişini verip lezzet dünyasına katılmaya ne dersin?</p>
                <a href="/Customer/Menu" class="btn btn-outline-primary rounded-pill mt-2">Menüye Git</a>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                // Toplam Tutarı Hesapla (Detaylardaki Adet * Fiyat)
                decimal totalPrice = item.OrderDetails.Sum(x => x.Quantity * x.UnitPrice);

                <div class="order-card">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                        <div>
                            <h4 class="fw-bold mb-1">Sipariş #@item.Id</h4>
                            <div class="text-muted small">
                                <i class="far fa-clock me-1"></i> @item.OrderDate.ToString("dd.MM.yyyy - HH:mm")
                            </div>
                        </div>

                        <div class="text-end">
                            <div class="price-tag mb-2">₺@totalPrice.ToString("0.00")</div>

                            @if (item.Status == true)
                            {
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <span class="status-badge">Hazırlanıyor <i class="fas fa-fire ms-1"></i></span>

                                    <a href="/Customer/CancelOrder/@item.Id"
                                       class="btn btn-sm btn-outline-danger rounded-pill fw-bold"
                                       onclick="return confirm('Siparişi iptal etmek istediğinize emin misiniz?');">
                                        <i class="fas fa-times me-1"></i>İptal Et
                                    </a>
                                </div>
                            }
                            else
                            {
                                <span class="status-badge" style="background-color:#ddd; color:#777;">
                                    <i class="fas fa-check-circle me-1"></i>Tamamlandı
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        }

    </div>

</body>
</html>